# Normalize line endings on the way in; leave the working tree to the platform.
* text=auto

# ── GitHub presentation ────────────────────────────────────────────────
# The fight record and the fixture repos are DATA and DELIBERATELY BROKEN
# CODE. Without these markers GitHub's language bar reports the synthetic
# fixture repos as the project, and every diff drags in megabytes of replay
# logs. They still ship; they just stop pretending to be the source.

# The replayable fight record — generated artifacts, hashed and sealed.
docs/fights/**              linguist-generated=true
docs/fights/*.ndjson        -diff
docs/fights/fight-night.html -diff

# Fixture repositories: intentionally broken codebases the harness fights.
gauntlet/fixtures/**        linguist-vendored=true
creative-suite/fixtures/**  linguist-vendored=true
test/fixtures/**            linguist-vendored=true
examples/**                 linguist-documentation=true

# Playable deliveries retain their recorded bytes and stay out of harness stats.
site/examples/ashworth/game/** -text linguist-generated=true
site/examples/ashworth/game/vendor/** linguist-vendored=true -whitespace

# Lockfile: keep it, don't review it.
package-lock.json           linguist-generated=true -diff

# Binary assets.
*.png                       binary
assets/bantam-frames.json   linguist-generated=true -diff
