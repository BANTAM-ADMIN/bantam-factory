        "purpose": "Clamp exactly one released test obligation and its public scenario rack.",
        "worker": { "kind": "tool", "adapter": "bantam.factory.test-obligation-intake/v1" },
        "inputs": [],
        "outputs": [{ "name": "obligation", "artifactType": "bantam.test-obligation/v1", "required": true }],
