          "fixtures": ["One-obligation limit", "Closed scenario catalog", "Content-addressed packet"],
          "prohibited": ["Do not include the whole contract.", "Do not include another obligation.", "Do not expose the held-out expected scenario."],
          "releaseCriteria": ["The packet contains exactly one obligation and unique scenario identifiers."]
