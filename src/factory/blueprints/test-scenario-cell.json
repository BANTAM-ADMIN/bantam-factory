        "worker": { "kind": "model", "adapter": "bantam.factory.test-scenario-selector/v1" },
        "inputs": [{ "name": "obligation", "artifactType": "bantam.test-obligation/v1", "required": true }],
        "outputs": [{ "name": "selection", "artifactType": "bantam.test-scenario-selection/v1", "required": true }],
        "capabilities": ["model.semantic-work"],
        "authority": ["test-obligation.read"],
        "gauge": { "id": "test-scenario-selection-shape", "version": 1, "independent": true },
