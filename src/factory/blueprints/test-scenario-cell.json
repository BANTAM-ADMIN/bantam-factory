          "operation": "Peck one scenario button for one obligation",
          "instructions": ["Read only the supplied obligation.", "Choose exactly one scenario identifier from the public rack.", "Return only the constrained selection object."],
          "fixtures": ["Finite scenario rack", "Literal-ID GBNF die", "No workspace, contract, plan, shell, or mutation tools"],
          "prohibited": ["Do not invent a scenario.", "Do not select multiple scenarios.", "Do not explain the choice."],
          "releaseCriteria": ["The response has the exact schema and one known scenario identifier."]
